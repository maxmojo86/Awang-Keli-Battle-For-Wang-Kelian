# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL: Separately hosted backend URLs for online leaderboards and multiplayer.
# Leave unset or empty for a standalone solo build (multiplayer & global leaderboards
# will cleanly show as unavailable while Solo Royale and Local Top 10 remain fully functional).
# Set to "same-origin" if serving the app and server.ts from the same domain.
# VITE_API_BASE_URL="https://api.awang-keli.example.com"
# VITE_WS_URL="wss://api.awang-keli.example.com/ws"

# OPTIONAL: CORS allowed origin on server.ts when hosting the backend separately
# (defaults to "*" when unset).
# CORS_ORIGIN="*"
