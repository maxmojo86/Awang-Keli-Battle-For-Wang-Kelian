# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPTIONAL: Separately hosted backend URLs for online leaderboards and multiplayer.
# Leave unset or empty for a standalone offline-ready solo build (multiplayer & global
# leaderboards will cleanly show as unavailable while Solo Royale, Guide Mode, and
# Local Top 10 remain fully functional).
# For Android Capacitor builds using a separately deployed Node/WebSocket server,
# set HTTPS / WSS URLs in .env.production before running `npm run android:sync`:
# VITE_API_BASE_URL="https://api.awang-keli.example.com"
# VITE_WS_URL="wss://api.awang-keli.example.com/ws"

# OPTIONAL: CORS allowed origin on server.ts when hosting the backend separately
# (defaults to "*" when unset; Capacitor Android WebView sends Origin: https://localhost).
# CORS_ORIGIN="*"

# OPTIONAL: Standalone Web & PWA voluntary support checkout URL override (must be https://).
# Defaults to https://buy.stripe.com/5kQ9ASgXJ1q91tv3Iv2B200 in standalone web builds and is
# automatically excluded from Android and YouTube Playables builds.
# Note: Changing any VITE_ variable requires rebuilding and redeploying the frontend.
# VITE_SUPPORT_URL="https://buy.stripe.com/5kQ9ASgXJ1q91tv3Iv2B200"

# REQUIRED IN PRODUCTION FOR GLOBAL/REGIONAL LEADERBOARDS (SERVER-ONLY — NEVER PREFIX WITH VITE_):
# PostgreSQL connection string for durable leaderboard persistence (e.g. Render PostgreSQL, Neon, Supabase).
# In production, the server never silently falls back to ephemeral local JSON files if this is unset.
DATABASE_URL=

# OPTIONAL (SERVER-ONLY): TLS mode for PostgreSQL connections.
# Auto-enabled for production non-local hosts and sslmode=require URLs.
# Set DATABASE_SSL="false" only for non-TLS local/internal connections.
# DATABASE_SSL="true"
# DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# OPTIONAL (DEVELOPMENT ONLY — IGNORED IN PRODUCTION):
# Set to "true" to explicitly opt into local .data/global-leaderboard.json storage during local dev
# when DATABASE_URL is not configured.
# LEADERBOARD_DEV_JSON_FALLBACK="true"

